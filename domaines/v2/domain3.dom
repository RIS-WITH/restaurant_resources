    // ============================================================================
    // === PHASE 4 ADD — Pratiques contextuelles temps-de-service (Ch6 §6.2)
    // === BrasserieService active 11h30-14h30, GastronomicService active 19h-22h
    // === Conditions single-clause SPARQL (cf. bug Yggdrasil multi-clause)
    // ============================================================================

    PRACTICE BrasserieService {
        DESCRIPTION {
            "Mode de service brasserie (rapide, decontracte). Active 11h30-14h30."
        };
        // Phase 4-bis : condition reformulee sur propriete derivee.
        // - FILTER non supporte par Yggdrasil
        // - sujet doit etre litteral (variables non extraites)
        // - prefix onto: requis pour router via OntologeniusDataSource
        // sys_clock_publisher publie 'LeComptoir hasActiveServiceMode brasserie'
        // selon l'heure simulee (mode -> brasserie en [11h,15h)).
        CONDITIONS {
            SELECT * WHERE {
                LeComptoir onto:hasActiveServiceMode brasserie.
            }
        };
        ROLES {
            - employeeOfRestaurant {
                CAPACITES: {
                    CAPACITE CanServeQuickly {
                        CAN_SATISFY_EXPECTATIONS: [QuickWelcome, QuickMeal];
                        DESCRIPTION: "Servir rapidement en mode brasserie";
                    };
                };
            };
            - client {
                ATTENTES: {
                    ATTENTE QuickWelcome {
                        TYPE: accueil_rapide;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Accueil chaleureux mais bref (mode brasserie)";
                    };
                    ATTENTE QuickMeal {
                        TYPE: service_repas;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Repas servi sans formalisme particulier";
                    };
                }
            };
        };
        COMPETENCES {
            - "Adapter le ton au registre informel.";
            - "Optimiser pour la rapidite.";
        };
        RULES {
            - "Eviter les longues explications de plats.";
        };
    };

    PRACTICE GastronomicService {
        DESCRIPTION {
            "Mode de service gastronomique (formel, ceremonial). Active 19h-22h."
        };
        // Phase 4-bis : meme reformulation que BrasserieService.
        CONDITIONS {
            SELECT * WHERE {
                LeComptoir onto:hasActiveServiceMode gastronomic.
            }
        };
        ROLES {
            - employeeOfRestaurant {
                CAPACITES: {
                    CAPACITE CanServeDish {
                        CAN_SATISFY_EXPECTATIONS: [ReceiveDish];
                        DESCRIPTION: "Servir un plat dresse";
                    };
                    CAPACITE CanPresentDish {
                        CAN_SATISFY_EXPECTATIONS: [DiningExperience];
                        DESCRIPTION: "Presenter un plat avec sa preparation";
                    };
                    CAPACITE CanWelcome {
                        CAN_SATISFY_EXPECTATIONS: [FormalWelcome];
                        DESCRIPTION: "Accueil ceremonial gastronomique";
                    };
                };
            };
            - client {
                ATTENTES: {
                    ATTENTE FormalWelcome {
                        TYPE: accueil_ceremonial;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Accueil ceremonial gastronomique";
                    };
                    ATTENTE WineAdvice {
                        TYPE: conseil_vin;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Recommandations sur la carte des vins";
                    };
                    ATTENTE DiningExperience {
                        TYPE: experience_complete;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Experience gastronomique complete";
                    };
                    ATTENTE ReceiveDish {
                        TYPE: service_plat;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Plat recu avec presentation";
                    };
                }
            };
        };
        COMPETENCES {
            - "Maitriser le vocabulaire gastronomique.";
            - "Annoncer chaque plat avec sa preparation.";
        };
        RULES {
            - "Toujours presenter le plat avant de le servir.";
            - "Proposer un complement ou un conseil vin.";
        };
    };

    // === END PHASE 4 ADD
};




// ------------------------------
// Définition des actions
// ------------------------------
ACTIONS {
    ACTION goTo(Location L) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            NOT ?@executor isAt L;
        };

        EFFECTS {
           ?@executor isAt L;
        };

        // RECOGNITION {
        //    SEQUENCE {
        //         ?@executor isInArea ?L REQUIRED;
        //    };
        //    PARAMETERS {
        //        ttl(20);
        //    };
        // };
        DESCRIPTION {
            ?? isA goToAction;
            ?? hasObjectif ?L;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/go_to", {"location": L});
        };
    };

    ACTION Saluer(Agent Target) {
        PRECONDITIONS {
            ?@executor isCapableOf welcoming;
            ?@executor hasStatus available;
            ?@executor isInArea WelcomingArea;
            Target isInArea WelcomingArea;
        };
        EFFECTS {
           Target hasStatus welcomed;
        };
        RECOGNITION {
           SEQUENCE {
                ?Target canHear ?@executor;
                ?@executor says WelcomeSentence REQUIRED;
           };
           PARAMETERS {
               ttl(20);
           };
        };
        DESCRIPTION {
            ?? isA welcomeAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?Target;
        };
        EXECUTION {
            call_service("/saluer", {"target": Target});
        };
    }
    

    ACTION GoToArea(Area T) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            NOT ?@executor isInArea T;
        };
        EFFECTS {
           ?@executor isInArea T;
        };
        RECOGNITION {
           SEQUENCE {
                ?@executor hasHandStatus free;
                ?@executor isInArea ?T REQUIRED;
           };
           PARAMETERS {
               ttl(20);
           };
        };
        DESCRIPTION {
            ?? isA goToAction;
            ?? hasObjectif ?T;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/go_to_area", {"area": T});
        };
    };

    ACTION updateTableStatus(Table T)
    {
        PRECONDITIONS {
            ?@executor isCapableOf updating;
            ?@executor isInArea RestaurantArea;
        };
        EFFECTS {
           T hasStatus not_unknown;
        };
        DESCRIPTION {
            ?? isA updateTableStatusAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?T;

        };
        EXECUTION {
            call_service("/update_table_status", {"table": T});
        };
    };

    ACTION GetDish(Dish D) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            ?@executor hasHandStatus free;
            D hasStatus ready_to_serve;
        };
        EFFECTS {
           ?@executor hasInHand D;
           D hasStatus being_carried;
        };
        DESCRIPTION {
            ?? isA getDishAction;
            ?? hasObjectif ?D;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/get_dish", {"dish": D});
        };
    };

    ACTION CheckPresentation(Dish D) {
        PRECONDITIONS {
            ?@executor hasInHand D;
        };
        EFFECTS {
           D hasPresentationChecked true;
        };
        DESCRIPTION {
            ?? isA checkPresentationAction;
            ?? hasObjectif ?D;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/check_presentation", {"dish": D});
        };
    };

    ACTION GoToTable(Table T) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
        };
        EFFECTS {
           ?@executor isNear T;
        };
        DESCRIPTION {
            ?? isA goToTableAction;
            ?? hasObjectif ?T;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/go_to_table", {"table": T});
        };
    };

    ACTION DeliverDish(Dish D, Table T) {
        PRECONDITIONS {
            ?@executor hasInHand D;
            ?@executor isNear T;
        };
        EFFECTS {
           ?@executor hasHandStatus free;
           D hasStatus served;
           T hasStatus served;
        };
        DESCRIPTION {
            ?? isA deliverDishAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?T;
        };
        EXECUTION {
            call_service("/deliver_dish", {"dish": D, "table": T});
        };
    };

    ACTION PresentDish(Dish D, Table T) {
        PRECONDITIONS {
            ?@executor isNear T;
            D hasStatus served;
        };
        EFFECTS {
           D hasStatus presented;
        };
        DESCRIPTION {
            ?? isA presentDishAction;
            ?? hasObjectif ?D;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?T;
        };
        EXECUTION {
            call_service("/present_dish", {"dish": D, "table": T});
        };
    };

    ACTION OfferComplement(Table T) {
        PRECONDITIONS {
            ?@executor isNear T;
        };
        EFFECTS {
           T hasComplementOffered true;
        };
        DESCRIPTION {
            ?? isA offerComplementAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?T;
        };
        EXECUTION {
            call_service("/offer_complement", {"table": T});
        };
    };
    ACTION patrol() {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            ?@executor hasStatus available;
        };
        EFFECTS {
           ?@executor isEngagedIn patrolAction;
        };
        DESCRIPTION {
            ?? isA patrolAction;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/patrol", {});
        };
    };

};

// ------------------------------
// Note: Role expectations (ATTENTES) are now defined at the practice level
// ------------------------------

PRIORITIES {

    PRIORITY Accueillir {
        EVENT {
            SELECT ?agent WHERE {?? agentworld:matchExpectation accueil. ?agent agentworld:hasActiveExpectationType accueil.}
        };
        PRIORITY_LEVEL { 5; };

        OBJECTIVES {
            STATE {
                // SELECT ?Agent WHERE {
            //     ?Agent onto:hasRole potentiel_client.
            //     ?Agent onto:expect etre_accueillit.
            // }

            // ?Agent hasStatus welcomed;
            };
            TASK: Accueillir(?agent)
        };
    };


    PRIORITY PrepareRoom {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant. ?A onto:expect room_ready. }
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_room WHERE {
                ?restaurant_room onto:isA RestaurantRoom.
                ?restaurant_room onto:hasStatus not_ready.
            }
            ?restaurant_room isCleaned False;
        };
    };

    PRIORITY PrepareTables {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant. ?A onto:expect table_ready. }
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_table WHERE {
                ?restaurant_table onto:isA RestaurantTable.
                ?restaurant_table onto:hasStatus not_ready.
            }
            ?restaurant_table hasStatus ready;
        };
    };


};

// ------------------------------
// Définition des tâches
// ------------------------------
TASKS {
    TASK Accueillir(Agent A){
        ENTRY_STATE {
            ?? hasHandStatus free;
            ?? isInArea WelcomingArea;
        };
        GOAL {
            ?A hasStatus welcomed;
        };
        METHODS {
            1: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                    NOT ?? isInArea WelcomingArea;
                };
                SUBTASKS {
                    1:GoToArea(WelcomingArea);
                    2:Saluer(A) > 1;
                };
            }
            2: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                    ?? isInArea WelcomingArea;
                };
                SUBTASKS {
                    1:Saluer(A);
                };
            }
        }
        COST { 5; };
        DURATION { 5; };
        PARAMETERS { ttl(10); };
    };
      





    // ============================================================================
    // === PHASE 4 ADD — Task ServeFood avec deux methodes contextuelles (Ch6 §6.2)
    // === sigma_brasserie : 3 sous-taches (PRECOND : LeComptoir hasServiceMode brasserie)
    // === sigma_gastronomic : 6 sous-taches (PRECOND : LeComptoir hasServiceMode gastronomic)
    // ============================================================================

    TASK ServeFood(Dish D, Table T) {
        ENTRY_STATE {
            ?? hasHandStatus free;
            D hasStatus ready_to_serve;
        };
        GOAL {
            D hasStatus served;
        };
        METHODS {
            sigma_brasserie: {
                PRECONDITIONS {
                    LeComptoir hasActiveServiceMode brasserie;
                };
                SUBTASKS {
                    1:GetDish(D);
                    2:GoToTable(T) > 1;
                    3:DeliverDish(D, T) > 2;
                };
            }
            sigma_gastronomic: {
                PRECONDITIONS {
                    LeComptoir hasActiveServiceMode gastronomic;
                };
                SUBTASKS {
                    1:GetDish(D);
                    2:CheckPresentation(D) > 1;
                    3:GoToTable(T) > 2;
                    4:DeliverDish(D, T) > 3;
                    5:PresentDish(D, T) > 4;
                    6:OfferComplement(T) > 5;
                };
            }
        };
        COST { 8; };
        DURATION { 15; };
        PARAMETERS { ttl(60); };
    };

    // Tasks correspondant aux nouveaux SPGoals YAML (Ch6 §6.2)
    // QuickWelcome (mode brasserie) : accueil bref
    TASK QuickWelcome(Agent A) {
        ENTRY_STATE {
            ?? hasHandStatus free;
        };
        GOAL {
            A hasStatus welcomed;
        };
        METHODS {
            method_brief: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                };
                SUBTASKS {
                    1:Saluer(A);
                };
            }
        };
        COST { 2; };
        DURATION { 3; };
        PARAMETERS { ttl(15); };
    };

    // FormalWelcome (mode gastronomique) : accueil ceremonial
    TASK FormalWelcome(Agent A) {
        ENTRY_STATE {
            ?? hasHandStatus free;
        };
        GOAL {
            A hasStatus welcomed;
        };
        METHODS {
            method_ceremonial: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                };
                SUBTASKS {
                    1:GoToArea(WelcomingArea);
                    2:Saluer(A) > 1;
                };
            }
        };
        COST { 5; };
        DURATION { 8; };
        PARAMETERS { ttl(30); };
    };

    // ServeMainCourse : 1 arg agent (matche le binding Yggdrasil ?A onto:expect ReceiveDish).
    // Delegue a ServeFood (selection sigma1/sigma2 par hasActiveServiceMode du LeComptoir).
    // Phase 10 : aligne sur le pattern Hospital (1 arg <-> 1 var bindee).
    TASK ServeMainCourse(Agent A) {
        ENTRY_STATE {
            ?? hasHandStatus free;
        };
        GOAL {
            A hasStatus served;
        };
        METHODS {
            method_serve: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                };
                SUBTASKS {
                    1:ServeFood(default_dish, table_1);
                };
            }
        };
        COST { 10; };
        DURATION { 20; };
        PARAMETERS { ttl(60); };
    };

    // === END PHASE 4 ADD


    TASK PrepareRoom(Agent A, RestaurantRoom R) {
        ENTRY_STATE {
            SELECT ?client_area WHERE {?C onto:hasArea ?client_area;};
            ?A hasHandStatus free;
            ?A isInArea ?client_area;
        };
        GOAL {?C hasTable ?T;
              ?C hasStatus sit; };
        METHODS {
            1: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {?T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                };
            }
            manual: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                    3:AskForOrder(A, C) > 2;
                };
            }
            test: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T);
                    3:AskForOrder(A, C) > 2;
                };
            }
        };
        COST { 10; };
        DURATION { 10; };
        PARAMETERS { ttl(10); };
    };


};

