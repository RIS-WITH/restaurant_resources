include {
    "package::restaurant_resources/domaines/v2/action.dom";
    "package::restaurant_resources/domaines/v2/task.dom";
    "package::restaurant_resources/domaines/v2/signaling.dom";
    "package::restaurant_resources/domaines/v2/priorities.dom";
    "package::restaurant_resources/domaines/v2/robot_action.dom";
    "package::restaurant_resources/domaines/restaurant_tasks.dom";
};


PRACTICE_FRAMES {
    PRACTICE_FRAME restaurant {
        DESCRIPTION {
            "Ensemble des pratiques sociales nécessaires pour gérer l'expérience client dans un restaurant, de l'accueil jusqu'au rangement après le service."
        };
        CONDITIONS {
            SELECT * WHERE {
                pr2 onto:isIn Restaurant.
            }
        };
        PRACTICES_LIST {
            - salutation;
            // === PHASE 4 ADD : pratiques contextuelles temps-de-service (Ch6 §6.2)
            - BrasserieService;
            - GastronomicService;
            // === END PHASE 4 ADD
//            - accueil_client;
//            - presentation_menu;
//            - prise_commande;
//            - annonce_cuisine;
//            - service_plats;
//            - encaissement;
//            - rangement;
        };

        ROLES {
            - employeeOfRestaurant {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant.}
                };
                CAPACITES: {
                    CAPACITE travail_restaurant {
                        CAN_SATISFY_EXPECTATIONS: [basic_work];
                        DESCRIPTION: "Capacité basique de travail en restaurant";
                        CONDITIONS {
                            SELECT * WHERE {
                                ?? hasStatus available;
                            }
                        };
                    };
                };
            };

            - serveur {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant. ?? onto:hasCapability serve. }
                };
                CAPACITES: {
                    CAPACITE servir {
                        CAN_SATISFY_EXPECTATIONS: [service_repas, presentation_menu];
                        DESCRIPTION: "Capacité de servir les clients et présenter le menu";
                        CONDITIONS {
                            SELECT * WHERE { 
                                ?? hasStatus available;
                                ?? isInArea RestaurantArea OR ?? canReach RestaurantArea;
                            }
                        };
                    };
                };
                ATTENTES: {
                    ATTENTE environment_ready {
                        TYPE: work_environment_ready;
                        EXPECTS_FROM: [agent_entretien];
                        DESCRIPTION: "Environnement de travail préparé et propre";
                        CONDITIONS {
                            SELECT * WHERE { ?? hasWorkShift active. }
                        };
                    };
                };
            };
            - agent_accueil {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant. ?? onto:hasCapability welcome. }
                };
                
                ATTENTES: {
                    ATTENTE room_ready {
                        TYPE: work_environment_ready;
                        EXPECTS_FROM: [agent_entretien];
                        DESCRIPTION: "Zone d'accueil préparée";
                        CONDITIONS {
                            SELECT * WHERE { ?? hasWorkShift active. }
                        };
                    };
                };
            };
            - client {
                CONDITIONS {
                    SELECT * WHERE { NOT {?? onto:hasRole employeeOfRestaurant.}. }
                };
                ATTENTES: {
                    ATTENTE service_repas {
                        TYPE: service_repas;
                        EXPECTS_FROM: [serveur];
                        DESCRIPTION: "Recevoir un service de qualité";
                        CONDITIONS {
                            SELECT * WHERE { ?? onto:hasStatus seated. }
                        };
                    };
                };
            };
            - potentiel_client {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole potentiel_client. }
                };
                CAPACITES: {
                    CAPACITE consommation {
                        CAN_SATISFY_EXPECTATIONS: [];
                        DESCRIPTION: "Capacité de consommer dans un restaurant";
                        CONDITIONS {
                            SELECT * WHERE {
                                ?? hasStatus present;
                            }
                        };
                    };
                };
                ATTENTES: {
                    ATTENTE accueillit {
                        TYPE: accueil;
                        EXPECTS_FROM: [agent_accueil];
                        DESCRIPTION: "Être accueilli professionnellement à l'arrivée";
                        CONDITIONS {
                            SELECT * WHERE { ?? onto:hasStatus new_agent. }
                        };
                    };
                };
            };
            - cuisinier {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant. ?? onto:hasCapability cook. }
                };
                CAPACITES: {
                    CAPACITE cuisiner {
                        CAN_SATISFY_EXPECTATIONS: [preparation_plats];
                        DESCRIPTION: "Capacité de préparer les plats";
                        CONDITIONS {
                            SELECT * WHERE { 
                                ?? hasStatus available;
                                ?? isInArea kitchen_1 OR ?? canReach kitchen_1;
                            }
                        };
                    };
                };
                ATTENTES: {
                    ATTENTE kitchen_ready {
                        TYPE: work_environment_ready;
                        EXPECTS_FROM: [agent_entretien];
                        DESCRIPTION: "Cuisine préparée et équipée";
                        CONDITIONS {
                            SELECT * WHERE { ?? hasWorkShift active. }
                        };
                    };
                };
            };
            - agent_entretien {
                CONDITIONS {
                    SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant. ?? onto:hasCapability clean. }
                };
                CAPACITES: {
                    CAPACITE prepare_environment {
                        CAN_SATISFY_EXPECTATIONS: [work_environment_ready];
                        DESCRIPTION: "Capacité de préparer l'environnement de travail";
                        CONDITIONS {
                            SELECT * WHERE { 
                                ?? hasCapability clean;
                                ?? hasCapability organize;
                            }
                        };
                    };
                    CAPACITE nettoyer {
                        CAN_SATISFY_EXPECTATIONS: [nettoyage_zone];
                        DESCRIPTION: "Capacité de nettoyer les zones";
                        CONDITIONS {
                            SELECT * WHERE { 
                                ?? hasEquipment cleaning_tools;
                            }
                        };
                    };
                };
            };
        };
        OBJECTS {
            - porte;
            - comptoir;
            - menu_papier;
            - plateau;
            - terminal_paiement;
            - chariot_nettoyage;
        };
        RULES {
            - "Respecter la politesse et la courtoisie à chaque étape."
            - "Informer la supervision en cas de problème imprévu."
            - "Adapter la séquence si le client saute une étape (ex : pas de dessert)."
        };
    };
};


PRACTICES {
    PRACTICE salutation {
        DESCRIPTION {
            "Saluer l'agent à son arrivée et établir un contact visuel."
        };
        CONDITIONS {
            SELECT * WHERE {
                Agent onto:hasStatus arrived.
            }
        };
        ROLES {
            - employeeOfRestaurant {
                CAPACITES: {
                    CAPACITE accueillir {
                        CAN_SATISFY_EXPECTATIONS: [accueil];
                        DESCRIPTION: "Capacité d'accueillir les clients professionnellement";
                        CONDITIONS {
                            SELECT * WHERE { 
                                ?? hasStatus available;
                                ?? isInArea WelcomingArea OR ?? canReach WelcomingArea;
                            }
                        };
                    };
                };
                ATTENTES: {
                    ATTENTE room_ready {
                        TYPE: work_environment_ready;
                        EXPECTS_FROM: [agent_entretien];
                        DESCRIPTION: "Zone d'accueil préparée";
                        CONDITIONS {
                            SELECT ?restaurant, ?restaurant_area WHERE {    
                                ?restaurant onto:hasArea ?restaurant_area.
                                ?restaurant onto:isA Restaurant.
                            }
                            
                            SELECT * WHERE {?? onto:isInArea ?restaurant_area.
                            ?restaurant onto:hasRoomStatus not_ready.}
                        };
                    };
                }
            };
            - potentiel_client {
                ATTENTES: {
                    ATTENTE accueillit {
                        TYPE: accueil;
                        EXPECTS_FROM: [agent_accueil];
                        DESCRIPTION: "Être accueilli professionnellement à l'arrivée";
                        CONDITIONS {
                            SELECT * WHERE { ?? onto:hasStatus new_agent. }
                        };
                    };

                    ATTENTE conseiller {
                        TYPE: conseil;
                        EXPECTS_FROM: [employeeOfRestaurant];
                        DESCRIPTION: "Recevoir des conseils et de l'assistance";
                        CONDITIONS {
                            SELECT * WHERE { ?? onto:isInArea WelcomingArea. }
                        };
                    };
                }
            };
        };
        COMPETENCES {
            - "Utiliser un langage corporel ouvert."
            - "Maintenir un contact visuel."
            - "Adapter le ton de voix selon le contexte."
        };
        RULES {
            - "Toujours saluer le client en premier."
            - "Utiliser le nom du client si connu."
        };
    };

    
