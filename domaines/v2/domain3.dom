// ------------------------------
// Définition des actions
// ------------------------------
ACTIONS {
    ACTION goTo(Location L) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            NOT ?@executor isAt L;
        };

        EFFECTS {
           ?@executor isAt L;
        };

        // RECOGNITION {
        //    SEQUENCE {
        //         ?@executor isInArea ?L REQUIRED;
        //    };
        //    PARAMETERS {
        //        ttl(20);
        //    };
        // };
        DESCRIPTION {
            ?? isA goToAction;
            ?? hasObjectif ?L;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/go_to", {"location": L});
        };
    };

    ACTION Saluer(Agent Target) {
        PRECONDITIONS {
            ?@executor isCapableOf welcoming;
            ?@executor hasStatus available;
            ?@executor isInArea WelcomingArea;
            Target isInArea WelcomingArea;
        };
        EFFECTS {
           Target hasStatus welcomed;
        };
        RECOGNITION {
           SEQUENCE {
                ?Target canHear ?@executor;
                ?@executor says WelcomeSentence REQUIRED;
           };
           PARAMETERS {
               ttl(20);
           };
        };
        DESCRIPTION {
            ?? isA welcomeAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?Target;
        };
        EXECUTION {
            call_service("/saluer", {"target": Target});
        };
    }
    

    ACTION GoToArea(Area T) {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            NOT ?@executor isInArea T;
        };
        EFFECTS {
           ?@executor isInArea T;
        };
        RECOGNITION {
           SEQUENCE {
                ?@executor hasHandStatus free;
                ?@executor isInArea ?T REQUIRED;
           };
           PARAMETERS {
               ttl(20);
           };
        };
        DESCRIPTION {
            ?? isA goToAction;
            ?? hasObjectif ?T;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/go_to_area", {"area": T});
        };
    };

    ACTION updateTableStatus(Table T)
    {
        PRECONDITIONS {
            ?@executor isCapableOf updating;
            ?@executor isInArea RestaurantArea;
        };
        EFFECTS {
           T hasStatus not_unknown;
        };
        DESCRIPTION {
            ?? isA updateTableStatusAction;
            ?? isPerformBy ?@executor;
            ?? isPerformOn ?T;

        };
        EXECUTION {
            call_service("/update_table_status", {"table": T});
        };
    };

    ACTION patrol() {
        PRECONDITIONS {
            ?@executor isCapableOf moving;
            ?@executor hasStatus available;
        };
        EFFECTS {
           ?@executor isEngagedIn patrolAction;
        };
        DESCRIPTION {
            ?? isA patrolAction;
            ?? isPerformBy ?@executor;
        };
        EXECUTION {
            call_service("/patrol", {});
        };
    };
};

// ------------------------------
// Note: Role expectations (ATTENTES) are now defined at the practice level
// ------------------------------

PRIORITIES {

    PRIORITY Accueillir {
        EVENT {
            SELECT ?agent WHERE {?? agentworld:matchExpectation accueil. ?agent agentworld:hasActiveExpectationType accueil.}
        };
        PRIORITY_LEVEL { 5; };

        OBJECTIVES {
            STATE {
                // SELECT ?Agent WHERE {
            //     ?Agent onto:hasRole potentiel_client.
            //     ?Agent onto:expect etre_accueillit.
            // }

            // ?Agent hasStatus welcomed;
            };
            TASK: Accueillir(?agent)
        };
    };


    PRIORITY PrepareRoom {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant. ?A onto:expect room_ready. }
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_room WHERE {
                ?restaurant_room onto:isA RestaurantRoom.
                ?restaurant_room onto:hasStatus not_ready.
            }
            ?restaurant_room isCleaned False;
        };
    };

    PRIORITY PrepareTables {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant. ?A onto:expect table_ready. }
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_table WHERE {
                ?restaurant_table onto:isA RestaurantTable.
                ?restaurant_table onto:hasStatus not_ready.
            }
            ?restaurant_table hasStatus ready;
        };
    };


};

// ------------------------------
// Définition des tâches
// ------------------------------
TASKS {
    TASK Accueillir(Agent A){
        ENTRY_STATE {
            ?? hasHandStatus free;
            ?? isInArea WelcomingArea;
        };
        GOAL {
            ?A hasStatus welcomed;
        };
        METHODS {
            1: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                    NOT ?? isInArea WelcomingArea;
                };
                SUBTASKS {
                    1:GoToArea(WelcomingArea);
                    2:Saluer(A) > 1;
                };
            }
            2: {
                PRECONDITIONS {
                    ?? hasHandStatus free;
                    ?? isInArea WelcomingArea;
                };
                SUBTASKS {
                    1:Saluer(A);
                };
            }
        }
        COST { 5; };
        DURATION { 5; };
        PARAMETERS { ttl(10); };
    };
      





    TASK PrepareRoom(Agent A, RestaurantRoom R) {
        ENTRY_STATE {
            SELECT ?client_area WHERE {?C onto:hasArea ?client_area;};
            ?A hasHandStatus free;
            ?A isInArea ?client_area;
        };
        GOAL {?C hasTable ?T;
              ?C hasStatus sit; };
        METHODS {
            1: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {?T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                };
            }
            manual: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                    3:AskForOrder(A, C) > 2;
                };
            }
            test: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T);
                    3:AskForOrder(A, C) > 2;
                };
            }
        };
        COST { 10; };
        DURATION { 10; };
        PARAMETERS { ttl(10); };
    };


};

// ------------------------------
// Définition des priorités
// ------------------------------