// ------------------------------
// Définition des actions
// ------------------------------
ACTIONS {
    ACTION goTo(Agent A, Location L) {
        PRECONDITIONS {
            A isCapableOf moving;
            NOT A isAt L;
        };
        EFFECTS {
           A isAt L;
        };
        DESCRIPTION {
            ?? isA goToAction;
            ?? isPerformBy ?A;
        };
        EXECUTION {
            call_service("/go_to", {"agent": A, "location": L});
        };
    };

    ACTION goToArea(Agent A, Area T) {
        PRECONDITIONS {
            A isCapableOf moving;
            NOT A isInArea T;
        };
        EFFECTS {
           A isInArea T;
        };
        DESCRIPTION {
            ?? isA goToAction;
            ?? isPerformBy ?A;
        };
        EXECUTION {
            call_service("/go_to_area", {"agent": A, "area": T});
        };
    };

    ACTION updateTableStatus(Agent A, Table T)
    {
        PRECONDITIONS {
            A isCapableOf updating;
        };
        EFFECTS {
           T hasStatus not_unknown;
        };
        DESCRIPTION {
            ?? isA updateTableStatusAction;
            ?? isPerformBy ?A;
            ?? isPerformOn ?T;

        };
        EXECUTION {
            call_service("/update_table_status", {"agent": A, "table": T});
        };
    };

    ACTION patrol(Agent A) {
        PRECONDITIONS {
            A isCapableOf moving;
        };
        EFFECTS {
           A isEngagedIn patrolAction;
        };
        DESCRIPTION {
            ?? isA patrolAction;
            ?? isPerformBy ?A;
            ?? isPerformOn ?T;
        };
        EXECUTION {
            call_service("/patrol", {"agent": A});
        };
    };
};

// ------------------------------
// Définition des intentions
// ------------------------------
ATTENTES {
    ROLE serveur {
        CONDITIONS {
            SELECT * WHERE { ?? onto:hasRole employeeOfRestaurant. ?? onto:hasCapability serve. }
        };

        ATTENTE room_ready {
            CONDITIONS {
                SELECT ?restaurant, ?restaurant_area WHERE {
                    ?restaurant onto:hasArea ?restaurant_area.
                    ?restaurant onto:isA Restaurant.
                }
                ?? isInArea ?restaurant_area;
                ?restaurant hasRoomStatus not_ready;
           };
        };
    };

    ROLE potentiel_client {
        CONDITIONS {
            SELECT * WHERE { ?? onto:hasRole potentiel_client.};
        };


        ATTENTE accueillit {
            CONDITIONS {
               SELECT * WHERE { ?? onto:hasStatus new_agent. }
            };
        };

        ATTENTE conseiller {
            CONDITIONS {
                SELECT * WHERE { ?? onto:isInArea WelcomingArea. }
            };
        };
    };

};

PRIORITIES {

    PRIORITY Accueillir {
        EVENT {
            SELECT * WHERE {?? onto:hasRole employeeOfRestaurant; Agent onto:expect etre_accueillit; ?pratice practice:isAvailable salutation; };
        };
        PRIORITY_LEVEL { 5; };
        OBJECTIVES {

            SELECT ?Agent WHERE {
                ?Agent onto:hasRole potentiel_client;
                ?Agent onto:expect etre_accueillit;
            };

            ?Agent hasStatus welcomed;
        };
    }


    PRIORITY PrepareRoom {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant; ?A onto:expect room_ready ; };
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_room WHERE {
                ?restaurant_room onto:isA RestaurantRoom;
                ?restaurant_room onto:hasStatus not_ready;
            };
            ?restaurant_room isCleaned False;
        };
    };

    PRIORITY PrepareTables {
        EVENT {
            SELECT * WHERE {?A onto:hasRole employeeOfRestaurant; ?A onto:expect table_ready ; };
        };
        PRIORITY_LEVEL { 4; };
        OBJECTIVES {
            SELECT ?restaurant_table WHERE {
                ?restaurant_table onto:isA RestaurantTable;
                ?restaurant_table onto:hasStatus not_ready;
            };
            ?restaurant_table hasStatus ready;
        };
    };


};

// ------------------------------
// Définition des tâches
// ------------------------------
TASKS {
    TASK PrepareRoom(Agent A, RestaurantRoom R) {
        ENTRY_STATE {
            SELECT ?client_area WHERE {?C onto:hasArea ?client_area;};
            ?A hasHandStatus free;
            ?A isInArea ?client_area;
        };
        GOAL {?C hasTable ?T;
              ?C hasStatus sit; };
        METHODS {
            1: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {?T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                };
            }
            manual: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T) > 1;
                    3:AskForOrder(A, C) > 2;
                };
            }
            test: {
                PRECONDITIONS {
                    SELECT ?table_area WHERE {T onto:hasArea ?table_area;};
                    NOT ?A isInArea ?table_area;
                    NOT ?C isInArea ?table_area;
                };
                SUBTASKS {
                    1:GoTo(T);
                    2:PresentTable(C, T);
                    3:AskForOrder(A, C) > 2;
                };
            }
        };
        COST { 10; };
        DURATION { 10; };
        PARAMETERS { ttl(10); };
    };


};

// ------------------------------
// Définition des priorités
// ------------------------------
